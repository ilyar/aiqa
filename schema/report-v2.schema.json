{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aiqa/schema/report-v2.schema.json",
  "title": "AIQA multi-target report v2",
  "type": "object",
  "required": ["schema_version", "generated_at", "tool", "config", "targets", "summary"],
  "properties": {
    "schema_version": {"const": "aiqa.report.v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tool": {"$ref": "#/$defs/tool"},
    "config": {"$ref": "#/$defs/config"},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/targetReport"}},
    "summary": {"$ref": "#/$defs/runSummary"}
  },
  "additionalProperties": false,
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "go_version"],
      "properties": {
        "name": {"const": "aiqa"},
        "version": {"type": "string"},
        "commit": {"type": "string"},
        "build_date": {"type": "string"},
        "go_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": ["tests", "targets", "timeout", "formats", "fail_on"],
      "properties": {
        "tests": {"type": "array", "minItems": 1, "items": {"enum": ["compat", "model-param"]}},
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/targetConfig"}},
        "timeout": {"type": "string", "minLength": 1},
        "formats": {"type": "array", "items": {"enum": ["markdown", "json"]}},
        "fail_on": {"enum": ["core", "any", "never"]},
        "guidance": {"enum": ["full", "summary", "off"]}
      },
      "additionalProperties": false
    },
    "targetConfig": {
      "type": "object",
      "required": ["id", "protocol", "base_url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "protocol": {"enum": ["openai", "anthropic"]},
        "base_url": {"type": "string", "format": "uri"},
        "base_url_normalized": {"type": "boolean"},
        "requested_models": {"type": "array", "items": {"type": "string"}},
        "api_version": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"protocol": {"const": "anthropic"}}}, "then": {"required": ["api_version"]}}
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["id", "revision", "source", "source_commit", "scope"],
      "properties": {
        "schema_version": {"enum": ["aiqa.profile.v1", "aiqa.profile.v2"]},
        "id": {"type": "string", "minLength": 1},
        "protocol": {"enum": ["openai", "anthropic"]},
        "revision": {"type": "string", "format": "date"},
        "api_version": {"type": "string"},
        "base_url_semantics": {"enum": ["includes_v1", "prefix_before_v1"]},
        "source": {"type": "string", "format": "uri"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_ref_revision": {"type": "string"},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": ["model_count"],
      "properties": {
        "models": {"type": "array", "items": {"type": "object"}},
        "tests": {"type": "array", "items": {"type": "object"}},
        "compatibility": {"type": "array", "items": {"type": "object"}},
        "model_count": {"type": "integer", "minimum": 0},
        "external": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["target_id", "protocol", "kind", "id"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "protocol": {"enum": ["openai", "anthropic"]},
        "kind": {"enum": ["provider", "model"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["native", "official_sdk"]},
        "probe_id": {"type": "string"},
        "suite": {"type": "string"},
        "status": {"enum": ["pass", "fail", "warn", "unsupported", "skip", "error"]},
        "summary": {"type": "string"},
        "http_status": {"type": "integer", "minimum": 0},
        "artifact_ref": {"type": "string"},
        "related_requirement_ids": {"type": "array", "items": {"type": "string"}},
        "signals": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "name", "level", "subject", "applicability", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "level": {"enum": ["core", "optional"]},
        "subject": {"$ref": "#/$defs/subject"},
        "module": {"type": "string"},
        "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
        "status": {"enum": ["pass", "fail", "warn", "unsupported", "skip", "error", "not_applicable"]},
        "failure_kind": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "blocked_by": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "measure": {
      "type": "object",
      "required": ["total", "pass", "warn", "skip", "error", "percent"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["verdict", "verdict_reason", "core", "optional", "evidence", "comparison"],
      "properties": {
        "verdict": {"enum": ["pass", "pass-with-gaps", "partial", "fail", "inconclusive"]},
        "verdict_reason": {"type": "string"},
        "core": {"$ref": "#/$defs/measure"},
        "optional": {"$ref": "#/$defs/measure"},
        "evidence": {
          "type": "object",
          "required": ["total", "executed", "conclusive", "execution_percent", "conclusive_percent"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "executed": {"type": "integer", "minimum": 0},
            "conclusive": {"type": "integer", "minimum": 0},
            "execution_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "conclusive_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        },
        "comparison": {
          "type": "object",
          "required": ["policy", "rankable", "verdict_rank"],
          "properties": {
            "policy": {"type": "string"},
            "rankable": {"type": "boolean"},
            "verdict_rank": {"type": ["integer", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "thinking_tokens": {"type": "integer", "minimum": 0},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "provider_fields": {"type": "object", "additionalProperties": {"type": "integer"}}
      },
      "additionalProperties": false
    },
    "targetSummary": {
      "type": "object",
      "required": ["pass", "fail", "warn", "unsupported", "skip", "error", "required_pass", "required_fail", "status", "assessment"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "required_pass": {"type": "integer", "minimum": 0},
        "required_fail": {"type": "integer", "minimum": 0},
        "status": {"type": "string"},
        "assessment": {"$ref": "#/$defs/assessment"},
        "usage": {"$ref": "#/$defs/usage"},
        "context_probe_tokens": {"type": "integer", "minimum": 0}
      },
      "not": {"required": ["score"]},
      "additionalProperties": false
    },
    "guidance": {
      "type": "object",
      "required": ["schema_version", "status", "engine", "summary", "findings", "recommendations"],
      "properties": {
        "schema_version": {"const": "aiqa.guidance.v1"},
        "status": {"enum": ["complete", "partial", "disabled", "error"]},
        "error": {"type": "string"},
        "engine": {"type": "object"},
        "summary": {"type": "object"},
        "findings": {"type": "array"},
        "recommendations": {"type": "array"},
        "artifacts": {"type": "object"}
      },
      "additionalProperties": false
    },
    "rateLimit": {
      "type": "object",
      "required": ["successful_requests", "rate_limited_responses", "retries_recovered", "backoff_ms", "observed_safe_requests_per_second", "observed_safe_concurrency", "latency_samples", "mean_latency_ms", "p50_latency_ms", "p95_latency_ms"],
      "properties": {
        "successful_requests": {"type": "integer", "minimum": 0},
        "rate_limited_responses": {"type": "integer", "minimum": 0},
        "retries_recovered": {"type": "integer", "minimum": 0},
        "backoff_ms": {"type": "integer", "minimum": 0},
        "observed_safe_requests_per_second": {"type": "number", "minimum": 0},
        "observed_safe_concurrency": {"type": "integer", "minimum": 0},
        "latency_samples": {"type": "integer", "minimum": 0},
        "mean_latency_ms": {"type": "integer", "minimum": 0},
        "p50_latency_ms": {"type": "integer", "minimum": 0},
        "p95_latency_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["id", "assessment", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"},
        "compatibility": {"type": "array", "items": {"type": "object"}},
        "parameters": {"type": "array", "items": {"type": "object"}},
        "context": {"type": "object"},
        "external": {"type": "array", "items": {"type": "object"}},
        "rate_limit": {"$ref": "#/$defs/rateLimit"},
        "capabilities": {"type": "array", "items": {"type": "object"}},
        "modules": {"type": "array", "items": {"type": "object"}},
        "assessment": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"type": "string"}}, "additionalProperties": false},
        "summary": {"type": "object"}
      },
      "additionalProperties": false
    },
    "targetReport": {
      "type": "object",
      "required": ["id", "protocol", "profile", "discovery", "models", "requirements", "summary", "guidance", "rate_limit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "protocol": {"enum": ["openai", "anthropic"]},
        "profile": {"$ref": "#/$defs/profile"},
        "discovery": {"$ref": "#/$defs/discovery"},
        "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "summary": {"$ref": "#/$defs/targetSummary"},
        "guidance": {"$ref": "#/$defs/guidance"},
        "rate_limit": {"$ref": "#/$defs/rateLimit"}
      },
      "additionalProperties": false
    },
    "runSummary": {
      "type": "object",
      "required": ["verdict", "target_counts"],
      "properties": {
        "verdict": {"enum": ["pass", "pass-with-gaps", "partial", "fail", "inconclusive"]},
        "verdict_reason": {"type": "string"},
        "target_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "blocking_targets": {"type": "array", "items": {"type": "string"}}
      },
      "not": {"required": ["score"]},
      "additionalProperties": false
    }
  }
}
