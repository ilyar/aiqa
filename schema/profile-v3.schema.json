{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aiqa/schema/profile-v3.schema.json",
  "title": "AIQA compatibility profile v3",
  "type": "object",
  "required": ["schema_version", "id", "protocol", "revision", "base_url_semantics", "source", "source_commit", "sources", "scope", "modules", "probes", "extension_bindings", "standard_parameters", "vendor_extensions"],
  "properties": {
    "schema_version": {"const": "aiqa.profile.v3"},
    "id": {"type": "string", "minLength": 1},
    "protocol": {"enum": ["openai", "anthropic", "google-genai"]},
    "revision": {"type": "string", "format": "date"},
    "api_version": {"type": "string", "minLength": 1},
    "base_url_semantics": {"type": "string", "minLength": 1},
    "source": {"type": "string", "format": "uri"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_ref_revision": {"type": "string"},
    "scope": {"type": "string", "minLength": 1},
    "model_selection": {
      "type": "object",
      "properties": {
        "interactions_allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "interactions": {
          "type": "object",
          "properties": {
            "strategy": {"const": "explicit_or_allowlist"},
            "allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["kind", "url"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "revision": {"type": "string"},
          "reviewed_at": {"type": "string", "format": "date"},
          "version": {"type": "string"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "subject", "default_enabled", "cost_class", "probe_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "subject": {"enum": ["provider", "model"]},
          "always_applicable": {"type": "boolean"},
          "default_enabled": {"type": "boolean"},
          "cost_class": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "probe_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "probes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "category", "required", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "executor": {"enum": ["native", "extension"]}
        },
        "additionalProperties": false
      }
    },
    "extension_bindings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["extension_id", "suite_id", "requirement_id", "subject", "module"],
        "properties": {
          "extension_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
          "suite_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
          "requirement_id": {"type": "string", "minLength": 1},
          "related_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "subject": {"enum": ["provider", "model"]},
          "module": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "standard_parameters": {"type": "array", "items": {"type": "string"}},
    "vendor_extensions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"protocol": {"const": "anthropic"}}}, "then": {"required": ["api_version"], "properties": {"base_url_semantics": {"const": "prefix_before_v1"}}}},
    {"if": {"properties": {"protocol": {"const": "google-genai"}}}, "then": {"required": ["api_version"], "properties": {"api_version": {"pattern": "^v[0-9]+(?:beta[0-9]*|alpha[0-9]*)?$"}, "base_url_semantics": {"const": "prefix_before_api_version"}}}}
  ],
  "additionalProperties": false
}
