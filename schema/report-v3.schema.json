{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aiqa/schema/report-v3.schema.json",
  "title": "AIQA multi-target report v3",
  "type": "object",
  "required": ["schema_version", "generated_at", "tool", "config", "targets", "summary"],
  "properties": {
    "schema_version": {"const": "aiqa.report.v3"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tool": {"$ref": "#/$defs/tool"},
    "config": {"$ref": "#/$defs/config"},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "summary": {"$ref": "#/$defs/runSummary"},
    "forensic_trace": {"$ref": "#/$defs/forensicTrace"},
    "execution": {"$ref": "#/$defs/executionSummary"}
  },
  "additionalProperties": false,
  "$defs": {
    "status": {"enum": ["pass", "fail", "warn", "unsupported", "skip", "error"]},
    "forensicTrace": {
      "type": "object", "required": ["verdict_path", "status"],
      "properties": {"verdict_path": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "inconclusive", "not_requested"]}},
      "additionalProperties": false
    },
    "executionSummary": {
      "type": "object",
      "required": ["schema_version", "phase", "elapsed_ms", "global_request_capacity", "observed_peak_inflight", "planned_jobs", "finished_jobs", "cancelled_jobs", "pacing_group_count", "scheduler_policy", "estimate_method"],
      "properties": {
        "schema_version": {"const": "aiqa.execution-summary.v1"},
        "phase": {"enum": ["validating", "preparing", "plan_frozen", "running", "finalizing", "completed", "interrupted", "failed_runtime"]},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "global_request_capacity": {"type": "integer", "minimum": 1},
        "observed_peak_inflight": {"type": "integer", "minimum": 0},
        "planned_jobs": {"type": "integer", "minimum": 0},
        "finished_jobs": {"type": "integer", "minimum": 0},
        "cancelled_jobs": {"type": "integer", "minimum": 0},
        "pacing_group_count": {"type": "integer", "minimum": 0},
        "scheduler_policy": {"type": "string", "minLength": 1},
        "estimate_method": {"type": "string", "minLength": 1},
        "sum_request_wait_ms": {"type": "integer", "minimum": 0},
        "wall_time_with_waiters_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object", "required": ["name", "version", "go_version"],
      "properties": {"name": {"const": "aiqa"}, "version": {"type": "string"}, "commit": {"type": "string"}, "build_date": {"type": "string"}, "go_version": {"type": "string"}},
      "additionalProperties": false
    },
    "config": {
      "type": "object", "required": ["tests", "targets", "timeout", "formats", "fail_on"],
      "properties": {
        "tests": {"type": "array", "minItems": 1, "items": {"enum": ["compat", "model-param", "sdk", "ext-suite"]}},
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/targetConfig"}},
        "requested_models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "timeout": {"type": "string", "minLength": 1},
        "formats": {"type": "array", "items": {"enum": ["markdown", "json"]}},
        "fail_on": {"enum": ["core", "any", "never"]},
        "guidance": {"enum": ["full", "summary", "off"]},
        "ext_suites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allow_high_token_probes": {"type": "boolean"},
        "allow_persistent_resources": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "targetConfig": {
      "type": "object", "required": ["id", "protocol", "base_url"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "protocol": {"enum": ["openai", "anthropic", "google-genai"]}, "base_url": {"type": "string", "format": "uri"},
        "base_url_normalized": {"type": "boolean"}, "requested_models": {"type": "array", "items": {"type": "string"}}, "api_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object", "required": ["id", "revision", "source", "source_commit", "scope"],
      "properties": {
        "schema_version": {"const": "aiqa.profile.v3"}, "id": {"type": "string"}, "protocol": {"enum": ["openai", "anthropic", "google-genai"]}, "revision": {"type": "string", "format": "date"},
        "api_version": {"type": "string"}, "base_url_semantics": {"type": "string"}, "source": {"type": "string", "format": "uri"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_ref_revision": {"type": "string"}, "scope": {"type": "string"}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object", "required": ["target_id", "protocol", "kind", "id"],
      "properties": {"target_id": {"type": "string", "minLength": 1}, "protocol": {"enum": ["openai", "anthropic", "google-genai"]}, "kind": {"enum": ["provider", "model"]}, "id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "cache_creation_input_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0}, "thinking_tokens": {"type": "integer", "minimum": 0}, "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "reasoning_tokens": {"type": "integer", "minimum": 0},
        "provider_fields": {"type": "object", "additionalProperties": {"type": "integer"}}
      },
      "additionalProperties": false
    },
    "httpObservation": {
      "type": "object",
      "properties": {
        "status_code": {"type": "integer", "minimum": 0, "maximum": 599},
        "content_type": {"type": "string"},
        "request_id": {"type": "string"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "snippet": {"type": "string"}
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": ["code"],
      "properties": {"code": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"}, "root_cause": {"type": "string"}, "parameters": {"type": "object"}},
      "additionalProperties": false
    },
    "classification": {
      "type": "object", "required": ["kind"],
      "properties": {
        "kind": {"enum": ["provider_nonconformance", "checker_defect", "behavioral_observation", "execution_gap", "unsupported_capability", "insufficient_evidence"]},
        "requirement_id": {"type": "string"}, "profile_revision": {"type": "string"},
        "operation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "testResult": {
      "type": "object",
      "properties": {"classification": {"$ref": "#/$defs/classification"}},
      "additionalProperties": true
    },
    "parameterResult": {
      "type": "object",
      "properties": {"classification": {"$ref": "#/$defs/classification"}},
      "additionalProperties": true
    },
    "contextProbeResult": {
      "type": "object",
      "properties": {"classification": {"$ref": "#/$defs/classification"}},
      "additionalProperties": true
    },
    "provenance": {
      "type": "object", "required": ["id", "name", "version", "source", "protocol_version"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"}, "source": {"enum": ["builtin", "executable"]}, "protocol_version": {"const": "aiqa.ext.v2"},
        "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object", "required": ["status", "startup_duration_ms", "total_duration_ms", "exit_code", "pacing_compliance", "summary"],
      "properties": {"status": {"enum": ["pass", "error"]}, "startup_duration_ms": {"type": "integer", "minimum": 0}, "total_duration_ms": {"type": "integer", "minimum": 0}, "exit_code": {"type": "integer"}, "pacing_compliance": {"enum": ["host_enforced", "extension_required_unverified"]}, "summary": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string"}, "error": {"type": "string"}},
      "additionalProperties": false
    },
    "extensionSuite": {
      "type": "object", "required": ["extension_id", "suite_id", "subject", "outcome", "status", "duration_ms", "summary", "bound"],
      "properties": {
        "extension_id": {"type": "string"}, "suite_id": {"type": "string"}, "subject": {"$ref": "#/$defs/subject"},
        "outcome": {"enum": ["pass", "assertion_failed", "request_rejected", "execution_error", "skip"]}, "status": {"$ref": "#/$defs/status"},
        "duration_ms": {"type": "integer", "minimum": 0}, "duration_ns": {"type": "integer", "minimum": 1}, "summary": {"type": "string", "minLength": 1}, "http": {"$ref": "#/$defs/httpObservation"}, "usage": {"$ref": "#/$defs/usage"},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}}, "requirement_id": {"type": "string"}, "related_requirement_ids": {"type": "array", "items": {"type": "string"}},
        "bound": {"type": "boolean"}, "artifact_ref": {"type": "string"}, "error": {"type": "string"},
        "error_kind": {"enum": ["deadline_exceeded", "cancelled", "transport", "assertion", "process", "capability_rejection"]}, "error_code": {"type": "string"}, "classification": {"$ref": "#/$defs/classification"}
      },
      "additionalProperties": false
    },
    "extensionRun": {
      "type": "object", "required": ["provenance", "target_id", "subject", "runner", "suites"],
      "properties": {"provenance": {"$ref": "#/$defs/provenance"}, "target_id": {"type": "string"}, "subject": {"$ref": "#/$defs/subject"}, "runner": {"$ref": "#/$defs/runner"}, "suites": {"type": "array", "items": {"$ref": "#/$defs/extensionSuite"}}},
      "additionalProperties": false
    },
    "rateLimit": {
      "type": "object",
      "required": ["logical_requests", "physical_attempts", "successful_requests", "rate_limited_responses", "retry_attempts", "retries_recovered", "retries_exhausted", "backoff_ms", "latency_samples", "mean_latency_ms", "p50_latency_ms", "p95_latency_ms"],
      "properties": {
        "logical_requests": {"type": "integer", "minimum": 0}, "physical_attempts": {"type": "integer", "minimum": 0}, "successful_requests": {"type": "integer", "minimum": 0}, "rate_limited_responses": {"type": "integer", "minimum": 0}, "retry_attempts": {"type": "integer", "minimum": 0}, "retries_recovered": {"type": "integer", "minimum": 0}, "retries_exhausted": {"type": "integer", "minimum": 0}, "backoff_ms": {"type": "integer", "minimum": 0},
        "observed_safe_requests_per_second": {"type": "number", "minimum": 0}, "observed_safe_concurrency": {"type": "integer", "minimum": 0}, "latency_samples": {"type": "integer", "minimum": 0},
        "mean_latency_ms": {"type": "integer", "minimum": 0}, "p50_latency_ms": {"type": "integer", "minimum": 0}, "p95_latency_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object", "required": ["id", "assessment", "summary"],
      "properties": {"id": {"type": "string"}, "metadata": {"type": "object"}, "compatibility": {"type": "array", "items": {"$ref": "#/$defs/testResult"}}, "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameterResult"}}, "context": {"$ref": "#/$defs/contextProbeResult"}, "rate_limit": {"$ref": "#/$defs/rateLimit"}, "capabilities": {"type": "array", "items": {"type": "object"}}, "modules": {"type": "array", "items": {"$ref": "#/$defs/moduleAssessment"}}, "assessment": {"type": "object"}, "summary": {"type": "object"}},
      "additionalProperties": false
    },
    "moduleAssessment": {
      "type": "object",
      "required": ["id", "capability", "applicability", "reason"],
      "properties": {
        "id": {"type": "string"}, "capability": {"type": "string"}, "requested": {"type": "boolean"},
        "applicability": {"enum": ["applicable", "not_applicable", "unknown"]}, "execution": {"enum": ["executed", "skipped"]},
        "reason": {"type": "string"}, "source": {"type": "string"}, "confidence": {"type": "string"},
        "blocked_by": {"type": "array", "items": {"type": "string"}}, "test_ids": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "object"}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object", "required": ["id", "protocol", "profile", "discovery", "models", "summary", "guidance", "rate_limit"],
      "properties": {"id": {"type": "string"}, "protocol": {"enum": ["openai", "anthropic", "google-genai"]}, "profile": {"$ref": "#/$defs/profile"}, "discovery": {"type": "object", "properties": {"tests": {"type": "array", "items": {"$ref": "#/$defs/testResult"}}, "compatibility": {"type": "array", "items": {"$ref": "#/$defs/testResult"}}}, "additionalProperties": true}, "models": {"type": "array", "items": {"$ref": "#/$defs/model"}}, "requirements": {"type": "array", "items": {"type": "object"}}, "summary": {"type": "object", "not": {"required": ["score"]}}, "guidance": {"type": "object"}, "rate_limit": {"$ref": "#/$defs/rateLimit"}, "extension_rate_limit": {"$ref": "#/$defs/rateLimit"}, "extensions": {"type": "array", "items": {"$ref": "#/$defs/extensionRun"}}, "notes": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    },
    "runSummary": {
      "type": "object", "required": ["verdict", "target_counts"],
      "properties": {"verdict": {"enum": ["pass", "pass-with-gaps", "partial", "fail", "inconclusive"]}, "verdict_reason": {"type": "string"}, "target_counts": {"type": "object", "additionalProperties": {"type": "integer"}}, "blocking_targets": {"type": "array", "items": {"type": "string"}}},
      "not": {"required": ["score"]}, "additionalProperties": false
    }
  }
}
