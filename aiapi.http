### List Models
< {%
    const kind = request.environment.get("kind")
    if (kind === "anthropic") {
        client.global.headers.set("anthropic-version", "2023-06-01")
    }
    const key = request.environment.get("key")
    if (kind === "genai") {
        client.global.headers.set("X-goog-api-key", key)
    } else {
        client.global.headers.set("Authorization", `Bearer ${key}`)
    }
%}
GET {{base}}/models

> {%
    const {status, body} = response
    client.test("Status code is 200", function () {
        client.assert(status === 200, "Response status: " + status);
    });
    client.test("Response contains models list", function () {
        client.assert(body.data && body.data.length > 0, "Models empty");
    });
%}

### Chat Completions
< {%
    const kind = request.environment.get("kind")
    const model = request.environment.get("model")
    const payload = {
        text: "Respond with one number: 40 + 2",
        maxOutputTokens: 100,
    }
    request.variables.set("content", JSON.stringify({
        "model": model,
        "messages": [
            {"role": "user", "content": payload.text}
        ],
        "max_tokens": payload.maxOutputTokens
    }))
    if (kind === "anthropic") {
        client.global.headers.set("anthropic-version", "2023-06-01")
        request.variables.set("path", "messages")
    } else if (kind === "genai") {
        request.variables.set("path", `models/${model}:generateContent`)
        request.variables.set("content", JSON.stringify({
            "contents": [
                {
                    "parts": [{"text": payload.text}]
                }
            ],
            generationConfig: {
                maxOutputTokens: payload.maxOutputTokens,
                thinkingConfig: {includeThoughts: false}
            }
        }))
    } else {
        request.variables.set("path", "chat/completions")
    }
    // TODO set content to client
    const key = request.environment.get("key")
    if (kind === "genai") {
        client.global.headers.set("X-goog-api-key", key)
    } else {
        client.global.headers.set("Authorization", `Bearer ${key}`)
    }
%}
POST {{base}}/{{path}}
Content-Type: application/json

{{content}}

> {%
    const {status, body} = response
    client.test("Status code is 200", function () {
        client.assert(status === 200, "Response status: " + status);
    });
    const kind = request.environment.get("kind")
    client.test("Received text response", function () {
        let text
        if (kind === "anthropic") {
            text = response.body.content?.[0]?.text
        } else if (kind === "genai") {
            text = response.body.candidates?.[0]?.content?.parts?.[0]?.text
        } else {
            text = response.body.choices?.[0]?.message?.content
        }

        client.assert(
            typeof text === "string" && text.trim().length > 0,
            "Text response is missing or empty"
        )
    });
%}
