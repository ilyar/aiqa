#!/usr/bin/env bash
# Quality gate for Go coverage and Gremlins mutation-test efficacy.
set -euo pipefail

usage() {
  echo "usage: $0 <check|update>" >&2
  exit 2
}

mode=${1:-check}
case "$mode" in check|update) ;; *) usage ;; esac

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "qa-gate: run from inside a Git worktree" >&2
  exit 2
}
cd "$root"

if ! command -v gremlins >/dev/null 2>&1; then
  echo "qa-gate: gremlins is required; install it with:" >&2
  echo "  go install github.com/go-gremlins/gremlins/cmd/gremlins@latest" >&2
  exit 2
fi

run_dir=$(mktemp -d "${TMPDIR:-/tmp}/aiqa-qa-gate.XXXXXX")
trap 'rm -rf "$run_dir"' EXIT
coverage_profile="$run_dir/coverage.out"
mutation_report="$run_dir/mutations.json"

go test -coverprofile="$coverage_profile" ./...
coverage_output=$(go tool cover -func="$coverage_profile")
coverage_pct=$(awk '
  /^total:/ {
    value=$NF
    sub(/%$/, "", value)
    if (value ~ /^[0-9]+([.][0-9]+)?$/) { print value; exit }
  }
' <<<"$coverage_output")
if [[ -z "$coverage_pct" ]]; then
  echo "qa-gate: could not read total coverage from go tool cover output" >&2
  exit 2
fi

# Gremlins writes its machine-readable report directly to this fresh run directory.
gremlins run --output "$mutation_report"
if [[ ! -s "$mutation_report" ]]; then
  echo "qa-gate: gremlins did not produce a JSON report" >&2
  exit 2
fi

mutation_pct=$(python3 - "$mutation_report" <<'PY'
import json
import math
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        report = json.load(source)
    score = report["test_efficacy"]
    killed = report["mutants_killed"]
    lived = report["mutants_lived"]
    if any(isinstance(value, bool) or not isinstance(value, (int, float))
           for value in (score, killed, lived)):
        raise ValueError("metrics must be JSON numbers")
    if not math.isfinite(score) or score < 0 or score > 100:
        raise ValueError("test_efficacy must be a finite percentage from 0 to 100")
    if killed < 0 or lived < 0 or killed + lived <= 0:
        raise ValueError("no assessed mutants (mutants_killed + mutants_lived must be nonzero)")
except (OSError, json.JSONDecodeError, KeyError, ValueError) as error:
    print(f"qa-gate: invalid gremlins JSON report: {error}", file=sys.stderr)
    sys.exit(2)

print(f"{score:.6f}".rstrip("0").rstrip("."))
PY
)

if [[ "$mode" == update ]]; then
  python3 - "$root/.qa-gate.json" "$coverage_pct" "$mutation_pct" <<'PY'
import json
import math
import os
import sys
import tempfile

path, coverage, mutation = sys.argv[1:]
values = [float(coverage), float(mutation)]
if not all(math.isfinite(value) and 0 <= value <= 100 for value in values):
    raise SystemExit("qa-gate: measured metrics must be finite percentages from 0 to 100")
directory = os.path.dirname(path)
fd, temporary = tempfile.mkstemp(prefix=".qa-gate.json.", suffix=".tmp", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as output:
        json.dump({"min_coverage_pct": values[0], "min_mutation_score_pct": values[1]}, output, indent=2)
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
    os.replace(temporary, path)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
  printf 'Updated %s/.qa-gate.json\n' "$root"
  exit 0
fi

baseline="$root/.qa-gate.json"
if [[ ! -f "$baseline" ]]; then
  echo "qa-gate: missing $baseline; run '$0 update' to create it" >&2
  exit 2
fi

baseline_values=$(python3 - "$baseline" <<'PY'
import json
import math
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        baseline = json.load(source)
    values = [baseline["min_coverage_pct"], baseline["min_mutation_score_pct"]]
    if any(isinstance(value, bool) or not isinstance(value, (int, float))
           or not math.isfinite(value) or value < 0 or value > 100 for value in values):
        raise ValueError("thresholds must be finite JSON percentages from 0 to 100")
except (OSError, json.JSONDecodeError, KeyError, ValueError) as error:
    print(f"qa-gate: invalid baseline: {error}", file=sys.stderr)
    sys.exit(2)
print(*values)
PY
)
read -r required_coverage required_mutation <<<"$baseline_values"

passes() { awk -v current="$1" -v required="$2" 'BEGIN { exit !(current >= required) }'; }
status_coverage='[FAIL]'
status_mutation='[FAIL]'
passes "$coverage_pct" "$required_coverage" && status_coverage='[PASS]'
passes "$mutation_pct" "$required_mutation" && status_mutation='[PASS]'

printf '%-10s | %-10s | %-12s | %s\n' Metric Current Required Status
printf '%-10s | %-10s | >= %-9s | %s\n' Coverage "${coverage_pct}%" "${required_coverage}%" "$status_coverage"
printf '%-10s | %-10s | >= %-9s | %s\n' Mutation "${mutation_pct}%" "${required_mutation}%" "$status_mutation"

if [[ "$status_coverage" == '[PASS]' && "$status_mutation" == '[PASS]' ]]; then
  exit 0
fi

echo "Baseline/current diff:"
awk -v current="$coverage_pct" -v required="$required_coverage" \
  'BEGIN { printf "  Coverage: baseline %.2f%%, current %.2f%%, delta %+.2f%%\n", required, current, current-required }'
awk -v current="$mutation_pct" -v required="$required_mutation" \
  'BEGIN { printf "  Mutation: baseline %.2f%%, current %.2f%%, delta %+.2f%%\n", required, current, current-required }'
exit 1
